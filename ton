local RunService = game:GetService("RunService")

-- ประกาศ state ที่ไฟล์ต้น ไม่ใช่ global
local isLocked1 = false
local isLocked2 = false
local lockConnection1 = nil
local lockConnection2 = nil

local function TP(targetTP)
    local player = Players.LocalPlayer
    if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
        return
    end

    local hrp = player.Character.HumanoidRootPart
    hrp.CFrame = targetTP

    isLocked1 = true
    isLocked2 = false

    -- disconnect ของเก่าก่อนเสมอ
    if lockConnection1 then
        lockConnection1:Disconnect()
        lockConnection1 = nil
    end
    if lockConnection2 then
        lockConnection2:Disconnect()
        lockConnection2 = nil
    end

    lockConnection1 = RunService.Heartbeat:Connect(function()
        if not isLocked1 then return end
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = targetTP
            char.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero  -- ใช้แทน .Velocity (deprecated)
        end
    end)
end

local function stopMove()
    isLocked1 = false
    isLocked2 = false

    if lockConnection1 then
        lockConnection1:Disconnect()
        lockConnection1 = nil
    end
    if lockConnection2 then
        lockConnection2:Disconnect()
        lockConnection2 = nil
    end
end
