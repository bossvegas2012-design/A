function Collection:TriggerTargetPrompt(proximityPrompt)
    if not proximityPrompt or not proximityPrompt:IsA("ProximityPrompt") then 
        return 
    end
    if not proximityPrompt.Enabled then 
        return 
    end
    
    if fireproximityprompt then
        -- วิธีปกติ: ถ้า Executor รองรับ ก็สั่งยิงฟังก์ชันตรงๆ (เร็วที่สุด)
        fireproximityprompt(proximityPrompt)
    else
        -- วิธีสำรอง: ถ้าไม่รองรับ ให้จำลองการกดปุ่ม E ค้างไว้ 4 วินาที
        warn("Executor ไม่รองรับฟังก์ชัน fireproximityprompt -> กำลังใช้วิธีกด E ค้าง 4 วินาทีแทน")
        
        task.spawn(function()
            -- 1. ส่งสัญญาณว่า "กดปุ่ม E ลงไป" (KeyDown)
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            
            -- 2. รอค้างไว้เป็นเวลา 4 วินาทีตามที่กำหนด
            task.wait(4)
            
            -- 3. ส่งสัญญาณว่า "ปล่อยปุ่ม E" (KeyUp)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)
    end
end
