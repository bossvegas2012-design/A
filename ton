local camera = workspace.CurrentCamera
local function LookUpInstant()
    local character = Player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        -- 1. เปลี่ยนโหมดกล้องให้สคริปต์ควบคุมได้
        camera.CameraType = Enum.CameraType.Scriptable
        
        -- 2. ตั้งพิกัดกล้องให้อยู่ด้านหลังตัวละครเล็กน้อย และหันมองไปข้างหน้า
        local baseCFrame = CFrame.new(hrp.Position + Vector3.new(0, 5, 10), hrp.Position)
        
        -- 3. สั่งหมุนมุมกล้องเงยขึ้นฟ้า (ใช้ math.rad ในการกำหนดองศา เช่น 45 หรือ 60 องศา)
        camera.CFrame = baseCFrame * CFrame.Angles(math.rad(45), 0, 0)
        
        -- 4. คืนค่าการควบคุมกล้องให้ผู้เล่นตามปกติ (กล้องจะค้างอยู่ที่มุมใหม่นี้)
        task.wait(0.1)
        camera.CameraType = Enum.CameraType.Custom
    end
end
